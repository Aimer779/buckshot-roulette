# Jev System One dealer. Copy to `.env` (or `.env.local`) and fill a key.
# Files matching `.env` / `.env.local` are gitignored. Never prefix these with VITE_.

# Provider: auto | typesafe | openrouter
# auto = TypeSafe if TYPESAFE_API_KEY is set, otherwise OpenRouter.
JEV_PROVIDER=auto

# TypeSafe official API (https://console.typesafe.ai/settings/keys)
# Used by POST https://api.typesafe.ai/v1/systemone  model=jev-1.13.0
TYPESAFE_API_KEY=

# OpenRouter fallback (https://openrouter.ai/keys)
# Used by POST https://openrouter.ai/api/alpha/decisions  model=typesafe/jev-1.13
OPENROUTER_API_KEY=

# Optional overrides
# JEV_MODEL=jev-1.13.0
# JEV_TIMEOUT_MS=2500
# JEV_CONFIDENCE_MIN=0.55
